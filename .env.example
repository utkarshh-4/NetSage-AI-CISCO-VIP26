# AI Provider Selection (openai or anthropic)
AI_PROVIDER=openai

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
# Optional: Set custom base URL for OpenAI-compatible providers like OpenRouter, LocalAI, Ollama
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Anthropic API Configuration (alternative to OpenAI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Optional: Skip AI diagnosis and use rule-based analysis only
# Set to "true" to disable AI calls (useful for API quota limitations)
SKIP_AI=false
